APP_NAME="Oficina API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL (valores apenas para ambiente LOCAL - nunca reutilize em produção)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=oficina
DB_USERNAME=oficina
DB_PASSWORD=oficina
DB_HOST_PORT=5432

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync

# JWT - gerado por `make setup` (php artisan jwt:secret). NUNCA commitar o valor real.
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# UID/GID do host p/ evitar problemas de permissão no container (Linux/WSL)
UID=1000
GID=1000
